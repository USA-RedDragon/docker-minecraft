{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Java base image overrides",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "\"(?<depName>amazoncorretto):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
            ],
            "datasourceTemplate": "docker",
            "autoReplaceStringTemplate": "\"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\""
        },
        {
            "customType": "regex",
            "description": "Paper build for each Minecraft version",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "mc\\s*=\\s*\"(?<packageName>[^\"]+)\",\\s*build\\s*=\\s*\"(?<currentValue>\\d+)\""
            ],
            "datasourceTemplate": "custom.paper-builds",
            "depNameTemplate": "paper-{{{packageName}}}",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "description": "Fabric loader",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "variable \"FABRIC_LOADER_VERSION\" \\{\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "net.fabricmc:fabric-loader",
            "registryUrlTemplate": "https://maven.fabricmc.net/"
        },
        {
            "customType": "regex",
            "description": "Fabric installer",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "variable \"FABRIC_(?:LEGACY_)?INSTALLER_VERSION\" \\{\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "net.fabricmc:fabric-installer",
            "registryUrlTemplate": "https://maven.fabricmc.net/"
        },
        {
            "customType": "regex",
            "description": "Recommended Forge release for each Minecraft version",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "forge\\s*=\\s*\"(?<packageName>[^-\"]+)-(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "custom.forge-recommended",
            "depNameTemplate": "forge-{{{packageName}}}",
            "versioningTemplate": "semver-coerced"
        },
        {
            "customType": "regex",
            "description": "Stable NeoForge build for each Minecraft version",
            "managerFilePatterns": [
                "/(^|/)docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "neoforge\\s*=\\s*\"(?<packageName>\\d+\\.\\d+)\\.(?<currentValue>\\d+)\"",
                "neoforge\\s*=\\s*\"(?<packageName>\\d+\\.\\d+\\.\\d+)\\.(?<currentValue>\\d+)\""
            ],
            "datasourceTemplate": "custom.neoforge-builds",
            "depNameTemplate": "neoforge-{{{packageName}}}",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "description": "ASM used to build the RCON fix",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG ASM_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "org.ow2.asm:asm"
        }
    ],
    "customDatasources": {
        "paper-builds": {
            "defaultRegistryUrlTemplate": "https://fill.papermc.io/v3/projects/paper/versions/{{packageName}}/builds",
            "transformTemplates": [
                "{\"releases\": [$$[channel=\"STABLE\"].{\"version\": $string(id)}], \"sourceUrl\": \"https://github.com/PaperMC/Paper\", \"homepage\": \"https://papermc.io\"}"
            ]
        },
        "forge-recommended": {
            "defaultRegistryUrlTemplate": "https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json?mc={{packageName}}",
            "transformTemplates": [
                "{\"releases\": [{\"version\": $lookup(promos, \"{{packageName}}-recommended\")}], \"sourceUrl\": \"https://github.com/MinecraftForge/MinecraftForge\", \"homepage\": \"https://files.minecraftforge.net\"}"
            ]
        },
        "neoforge-builds": {
            "defaultRegistryUrlTemplate": "https://maven.neoforged.net/api/maven/versions/releases/net/neoforged/neoforge?line={{packageName}}",
            "transformTemplates": [
                "{\"releases\": [$filter(versions, function($v) { $substringBefore($v, \"{{packageName}}.\") = \"\" and $not($contains($v, \"-\")) and $not($contains($substringAfter($v, \"{{packageName}}.\"), \".\")) }).{\"version\": $substringAfter($, \"{{packageName}}.\")}], \"sourceUrl\": \"https://github.com/neoforged/NeoForge\", \"homepage\": \"https://neoforged.net\"}"
            ]
        }
    },
    "packageRules": [
        {
            "matchDatasources": [
                "custom.paper-builds"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": true
        },
        {
            "matchDatasources": [
                "custom.neoforge-builds"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": true
        },
        {
            "description": "Minecraft 1.19.2 - 1.20.2 are held on the 0.11 Fabric installer",
            "matchPackageNames": [
                "net.fabricmc:fabric-installer"
            ],
            "matchCurrentVersion": "/^0\\./",
            "allowedVersions": "/^0\\./"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "amazoncorretto"
            ],
            "matchCurrentVersion": "/^17\\./",
            "allowedVersions": "/^17\\./"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "amazoncorretto"
            ],
            "matchCurrentVersion": "/^21\\./",
            "allowedVersions": "/^21\\./"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "amazoncorretto"
            ],
            "matchCurrentVersion": "/^25\\./",
            "allowedVersions": "/^25\\./"
        }
    ]
}
