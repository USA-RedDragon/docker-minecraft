{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs"
    ],
    "baseBranchPatterns": [
        "fabric",
        "paper",
        "/^mc\\/.*\\/.*/"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG PAPER_VERSION=(?<currentValue>.*)"
            ],
            "depNameTemplate": "paper-minecraft",
            "versioningTemplate": "semver-coerced",
            "datasourceTemplate": "custom.paper-minecraft"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG PAPER_VERSION=(?<mcVersion>.*)\\nARG PAPER_BUILD=(?<currentValue>.*)"
            ],
            "depNameTemplate": "paper-{{{mcVersion}}}-builds",
            "versioningTemplate": "loose",
            "datasourceTemplate": "custom.paper-{{{mcVersion}}}-builds"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG FABRIC_VERSION=(?<currentValue>.*)"
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "net.fabricmc:fabric-loader"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG INSTALLER_VERSION=(?<currentValue>.*)"
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "net.fabricmc:fabric-installer"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG MC_VERSION=(?<currentValue>.*)"
            ],
            "datasourceTemplate": "git-refs",
            "packageNameTemplate": "https://github.com/FabricMC/fabric",
            "depNameTemplate": "https://github.com/FabricMC/fabric"
        }
    ],
    "customDatasources": {
        "paper-minecraft": {
            "defaultRegistryUrlTemplate": "https://api.papermc.io/v2/projects/paper",
            "transformTemplates": [
                "{\"releases\":[{\"version\": $$.versions[-1],\"sourceUrl\":\"https://github.com/PaperMC/Paper\",\"changelogUrl\":\"https://papermc.io/downloads/all\"}],\"sourceUrl\": \"https://github.com/PaperMC/Paper\",\"homepage\": \"https://papermc.io\"}"
            ]
        },
        "paper-1.20.1-builds": {
            "defaultRegistryUrlTemplate": "https://api.papermc.io/v2/projects/paper/versions/1.20.1/builds",
            "transformTemplates": [
                "{\"releases\":[{\"version\": $string($$.builds[-1].build),\"sourceUrl\":\"https://github.com/PaperMC/Paper\",\"changelogUrl\":\"https://papermc.io/downloads/all\"}],\"sourceUrl\": \"https://github.com/PaperMC/Paper\",\"homepage\": \"https://papermc.io\"}"
            ]
        },
        "paper-1.20.2-builds": {
            "defaultRegistryUrlTemplate": "https://api.papermc.io/v2/projects/paper/versions/1.20.2/builds",
            "transformTemplates": [
                "{\"releases\":[{\"version\": $string($$.builds[-1].build),\"sourceUrl\":\"https://github.com/PaperMC/Paper\",\"changelogUrl\":\"https://papermc.io/downloads/all\"}],\"sourceUrl\": \"https://github.com/PaperMC/Paper\",\"homepage\": \"https://papermc.io\"}"
            ]
        },
        "paper-1.20.4-builds": {
            "defaultRegistryUrlTemplate": "https://api.papermc.io/v2/projects/paper/versions/1.20.4/builds",
            "transformTemplates": [
                "{\"releases\":[{\"version\": $string($$.builds[-1].build),\"sourceUrl\":\"https://github.com/PaperMC/Paper\",\"changelogUrl\":\"https://papermc.io/downloads/all\"}],\"sourceUrl\": \"https://github.com/PaperMC/Paper\",\"homepage\": \"https://papermc.io\"}"
            ]
        }
    },
    "packageRules": [
        {
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/paper-.*-builds/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/paper\\/1\\.20\\.1/"
            ],
            "allowedVersions": "<=1.20.1",
            "matchPackageNames": [
                "/^paper-minecraft$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/paper\\/1\\.20\\.2/"
            ],
            "allowedVersions": "<=1.20.2",
            "matchPackageNames": [
                "/^paper-minecraft$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/paper\\/1\\.20\\.4/"
            ],
            "allowedVersions": "<=1.20.4",
            "matchPackageNames": [
                "/^paper-minecraft$/"
            ]
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "registryUrls": [
                "https://maven.fabricmc.net/"
            ],
            "matchPackageNames": [
                "/^net\\.fabricmc:fabric-.*$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.19\\.2/"
            ],
            "allowedVersions": "<=1.19.2",
            "matchPackageNames": [
                "/^https:\\/\\/github.com\\/FabricMC\\/fabric$/"
            ]
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.19\\.2/"
            ],
            "allowedVersions": "<0.12.0",
            "matchPackageNames": [
                "/^net\\.fabricmc:fabric-installer$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.20\\.1/"
            ],
            "allowedVersions": "<=1.20.1",
            "matchPackageNames": [
                "/^https:\\/\\/github.com\\/FabricMC\\/fabric$/"
            ]
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.20\\.1/"
            ],
            "allowedVersions": "<0.12.0",
            "matchPackageNames": [
                "/^net\\.fabricmc:fabric-installer$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.20\\.2/"
            ],
            "allowedVersions": "<=1.20.2",
            "matchPackageNames": [
                "/^https:\\/\\/github.com\\/FabricMC\\/fabric$/"
            ]
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.20\\.2/"
            ],
            "allowedVersions": "<0.12.0",
            "matchPackageNames": [
                "/^net\\.fabricmc:fabric-installer$/"
            ]
        },
        {
            "matchBaseBranches": [
                "/^mc\\/fabric\\/1\\.20\\.3/"
            ],
            "allowedVersions": "<=1.20.3",
            "matchPackageNames": [
                "/^https:\\/\\/github.com\\/FabricMC\\/fabric$/"
            ]
        }
    ]
}
